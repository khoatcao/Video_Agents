# ── Ollama (local LLM inference) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── YouTube Data API v3 / OAuth2 ──────────────────────────────────────────────
YOUTUBE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Meta Graph API (Facebook / Instagram Reels) ───────────────────────────────
FACEBOOK_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_PAGE_ID=000000000000000

# ── Affiliate networks (Vietnam market) ──────────────────────────────────────
SHOPEE_AFFILIATE_ID=your_shopee_affiliate_id
LAZADA_AFFILIATE_KEY=your_lazada_affiliate_key
TIKI_AFFILIATE_KEY=your_tiki_affiliate_key
# ACCESSTRADE_API_KEY=  # will be added later

# ── Pipeline I/O ──────────────────────────────────────────────────────────────
OUTPUT_DIR=./outputs

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Scheduling ────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Ho_Chi_Minh
