# ── Observability — LangSmith (https://smith.langchain.com) ──────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=video-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Ollama (local LLM inference) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM temperature (0.0 = deterministic, 1.0 = creative) ────────────────────
TEMPERATURE_CONTENT=0.0
TEMPERATURE_METADATA=0.0

# ── YouTube Data API v3 / OAuth2 (optional — leave blank to skip upload) ──────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Meta Graph API (optional — leave blank to skip upload) ────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/callback
FACEBOOK_PAGE_ID=
# No FACEBOOK_ACCESS_TOKEN needed — token is stored automatically in facebook_token.json

# ── Affiliate networks (Vietnam market) ──────────────────────────────────────
SHOPEE_AFFILIATE_ID=your_shopee_affiliate_id
LAZADA_AFFILIATE_KEY=your_lazada_affiliate_key
TIKI_AFFILIATE_KEY=your_tiki_affiliate_key
# ACCESSTRADE_API_KEY=  # will be added later

# ── Pipeline I/O ──────────────────────────────────────────────────────────────
OUTPUT_DIR=./outputs

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Scheduling ────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Ho_Chi_Minh
